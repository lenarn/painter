---
import Layout from '../../layouts/Layout.astro';
import GalleryGrid from '../../components/GalleryGrid.astro';
import {
  loadCatalog,
  categoriesWithCounts,
  subcategoriesWithCounts,
  artworksByCategory,
  categoryHref,
  resolveImage,
} from '../../lib/catalog';
import { fullName, ogImageSrc } from '../../lib/seo';

// Категория может быть путём «раздел/подраздел» — rest-параметр category
// принимает вложенные пути (/gallery/иллюстрации/Сказка о…).
export function getStaticPaths() {
  const arts = loadCatalog();
  const paths: {
    params: { category: string };
    props: { name: string; path: string; count: number };
  }[] = [];
  for (const c of categoriesWithCounts(arts)) {
    paths.push({
      params: { category: c.name },
      props: { name: c.name, path: c.name, count: c.count },
    });
    for (const s of subcategoriesWithCounts(arts, c.name)) {
      paths.push({
        params: { category: s.path },
        props: { name: s.name, path: s.path, count: s.count },
      });
    }
  }
  return paths;
}

const { name, path, count } = Astro.props;
const arts = loadCatalog();
const subs = subcategoriesWithCounts(arts, path);
const grid = artworksByCategory(arts, path);
const isSub = path.includes('/');
const top = path.split('/')[0];
// og:image раздела — первая работа раздела; для разделов, где работы
// лежат только в подразделах (верхний уровень пуст), — первая попавшаяся.
const ogArt = grid[0] ?? arts.find((a) => a.categories.some((c) => c.startsWith(path + '/')));
const ogImage = await ogImageSrc(ogArt ? resolveImage(ogArt) : undefined);
---

<Layout
  title={`${name} — Галерея — ${fullName}`}
  description={`Раздел «${name}» галереи художника ${fullName}: ${count} ${count === 1 ? 'работа' : count < 5 ? 'работы' : 'работ'}.`}
  image={ogImage}
>
  <section class="section container">
    <nav class="crumbs" aria-label="Хлебные крошки">
      <a href="/gallery">Галерея</a>
      {isSub && (
        <>
          <span>/</span>
          <a href={categoryHref(top)}>{top}</a>
        </>
      )}
      <span>/</span>
      <span>{name}</span>
    </nav>
    <p class="eyebrow">Тема</p>
    <h1>{name}</h1>
    <p class="muted">{count} {count === 1 ? 'работа' : count < 5 ? 'работы' : 'работ'}</p>

    {subs.length > 0 && (
      <div class="cat-grid">
        {subs.map((s) => (
          <a href={categoryHref(s.path)} class="cat-card">
            <span class="cat-name">{s.name}</span>
            <span class="cat-count">{s.count} работ</span>
          </a>
        ))}
      </div>
    )}

    {grid.length > 0 && <GalleryGrid arts={grid} eager={true} from={path} />}
  </section>
</Layout>

<style>
  .crumbs { font-size: 0.8rem; color: var(--fg-soft); margin-bottom: 24px; display: flex; gap: 8px; }
  .crumbs a:hover { color: var(--accent); }

  .cat-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 20px; margin-top: 36px; }
  .cat-card {
    display: flex; flex-direction: column; justify-content: space-between; gap: 24px;
    padding: 32px; min-height: 160px;
    border: 1px solid var(--line); border-radius: var(--radius);
    background: var(--bg-soft);
    transition: border-color 0.2s ease, transform 0.2s ease, background 0.2s ease;
  }
  .cat-card:hover { border-color: var(--fg); transform: translateY(-3px); background: #fff; }
  .cat-name { font-family: var(--font-serif); font-size: 1.4rem; }
  .cat-count { font-size: 0.8rem; color: var(--fg-soft); }
</style>