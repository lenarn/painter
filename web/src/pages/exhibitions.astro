---
import Layout from '../layouts/Layout.astro';
import { Picture } from 'astro:assets';
import { exhibitionsData, type ExhibitionEntry } from '../lib/content';
import { loadCatalog, resolveImage, type Artwork } from '../lib/catalog';
import { fullName } from '../lib/seo';

// Работы выставки — по slug из catalog.json, порядок — как в списке записи.
// Несуществующие slug молча пропускаются (тот же контракт, что у news.ts).
function exhibitionArtworks(slugs: string[] | undefined, bySlug: Map<string, Artwork>): Artwork[] {
  if (!slugs) return [];
  return slugs.map((slug) => bySlug.get(slug)).filter((a): a is Artwork => Boolean(a));
}

const bySlug = new Map(loadCatalog().map((a) => [a.slug, a]));

// Группировка по году (годы в обратном порядке — свежие сверху).
const grouped = new Map<number, { entry: ExhibitionEntry; linked: Artwork[] }[]>();
for (const e of exhibitionsData) {
  const list = grouped.get(e.year) ?? [];
  list.push({ entry: e, linked: exhibitionArtworks(e.artworks, bySlug) });
  grouped.set(e.year, list);
}
const years = Array.from(grouped.keys()).sort((a, b) => b - a);
const yearsLine = years.length > 0 ? ` за ${Math.min(...years)}–${Math.max(...years)} годы` : '';
---

<Layout
  title={`Выставки — ${fullName}`}
  description={`Выставки художника ${fullName}: персональные и групповые${yearsLine}.`}
>
  <section class="section container">
    <p class="eyebrow">Выставки</p>
    <h1>Хронология выставок</h1>
    <p class="muted">Персональные и групповые. Список пополняется.</p>

    {years.length === 0 ? (
      <p class="muted">Записей пока нет.</p>
    ) : (
      <ol class="timeline">
        {years.map((year) => (
          <li class="tl-year">
            <h2 class="tl-year-head">{year}</h2>
            <ul class="tl-items">
              {grouped.get(year)!.map(({ entry: e, linked }) => (
                <li class="tl-item">
                  <span class="tl-period">{e.period}</span>
                  <div class="tl-body">
                    <div class="tl-title">{e.title}</div>
                    {e.place && <div class="tl-place muted">{e.place}</div>}
                    {e.note && <p class="tl-note muted">{e.note}</p>}
                    {linked.length > 0 && (
                      <div class="tl-artworks">
                        {linked.map((a) => {
                          const img = resolveImage(a);
                          return img && (
                            <a class="tl-thumb" href={`/artworks/${a.slug}`} title={a.title}>
                              <Picture
                                src={img}
                                alt={a.alt || a.title}
                                widths={[480, 760]}
                                sizes="240px"
                                formats={['webp']}
                                loading="lazy"
                                decoding="async"
                              />
                            </a>
                          );
                        })}
                      </div>
                    )}
                  </div>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
    )}
  </section>
</Layout>

<style>
  .timeline { list-style: none; margin: 40px 0 0; padding: 0; }
  .tl-year { padding-block: 20px; border-top: 1px solid var(--line); }
  .tl-year:last-child { border-bottom: 1px solid var(--line); }
  .tl-year-head {
    font-size: clamp(1.6rem, 3.5vw, 2.1rem);
    margin: 0 0 18px;
    color: var(--fg);
    font-variant-numeric: tabular-nums;
  }
  .tl-items { list-style: none; margin: 0; padding: 0; display: grid; gap: 22px; }
  .tl-item { display: grid; grid-template-columns: 180px 1fr; gap: 24px; }
  .tl-period {
    font-size: 0.9rem;
    color: var(--fg-soft);
    font-variant-numeric: tabular-nums;
    padding-top: 3px;
  }
  .tl-title { font-family: var(--font-serif); font-size: 1.2rem; }
  .tl-place { font-size: 0.95rem; margin-top: 2px; }
  .tl-note { font-size: 0.95rem; margin: 8px 0 0; max-width: 60ch; }
  /* Работы выставки: мини-превью в паспарту, клик — на страницу картины. */
  .tl-artworks {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 14px;
  }
  .tl-thumb {
    display: block;
    width: clamp(150px, 18vw, 200px);
    min-width: 120px;
    max-width: 100%;
    background: var(--frame);
    border: 1px solid var(--line);
    padding: 8px;
    box-shadow: var(--frame-shadow);
    border-radius: 4px;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .tl-thumb:hover {
    transform: translateY(-3px);
    box-shadow: 0 1px 2px rgba(20, 18, 14, 0.06), 0 20px 40px -14px rgba(20, 18, 14, 0.24);
  }
  .tl-thumb:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .tl-thumb picture, .tl-thumb img { display: block; width: 100%; height: auto; }
  @media (max-width: 560px) {
    .tl-item { grid-template-columns: 1fr; gap: 4px; }
    .tl-period { padding-top: 0; }
  }
</style>