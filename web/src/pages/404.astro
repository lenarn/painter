---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Не найдено — Елена" noIndex>
  <section class="section container center">
    <p class="eyebrow">404</p>
    <h1>Страница не найдена</h1>
    <p class="muted">Возможно, картина перемещена или ещё не опубликована.</p>
    <p><a href="/" class="btn">На главную</a></p>
  </section>
</Layout>

<style>
  .center { text-align: center; max-width: 60ch; margin-inline: auto; }
</style>