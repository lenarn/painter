---
import { existsSync } from 'node:fs';
import path from 'node:path';
import '../styles/global.css';
// Самохостинг Cormorant Garamond (кириллица). Файлы шрифта лежат локально,
// внешний запрос к Google Fonts не нужен.
import '@fontsource/cormorant-garamond/cyrillic-400.css';
import '@fontsource/cormorant-garamond/cyrillic-500.css';
import '@fontsource/cormorant-garamond/cyrillic-600.css';
import '@fontsource/cormorant-garamond/cyrillic-700.css';
import '@fontsource/cormorant-garamond/cyrillic-ext-400.css';
import '@fontsource/cormorant-garamond/cyrillic-ext-600.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { absUrl, fullName, personSchema, websiteSchema } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  /** og:image — путь от корня (например, img.src). Абсолютным станет сам. */
  image?: string;
  /** og:type: обычная страница — website, работа — article. */
  type?: 'website' | 'article';
  /** Служебные страницы (404) не индексируем. */
  noIndex?: boolean;
}

const {
  title = `${fullName} — художник`,
  description = `${fullName} — художник. Живопись и графика: галерея работ, новости, выставки, контакты.`,
  image,
  type = 'website',
  noIndex = false,
} = Astro.props;

// Canonical/og:url появляются, только когда в astro.config вписан домен.
const canonical = absUrl(Astro.url.pathname);
const ogImage = image ? absUrl(image) : undefined;
const siteJson = JSON.stringify([websiteSchema(absUrl('/')), personSchema(absUrl('/'))]);

// Фавикон персональный (картина владельца) и в git не входит — см. .gitignore.
// Личный favicon.png положен → PNG-ссылки; иначе (сборка из репо) — SVG-заглушка.
const hasFaviconPng = existsSync(path.join(process.cwd(), 'public', 'favicon.png'));
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={fullName} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta name="twitter:card" content="summary_large_image" />}
    {hasFaviconPng ? (
      <>
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
      </>
    ) : (
      <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    )}
    <title>{title}</title>
    <script type="application/ld+json" set:html={siteJson} />
  </head>
  <body>
    {/* Скип-линк: клавиатурный переход сразу к содержимому, мимо меню. */}
    <a class="skip-link" href="#main">Перейти к содержимому</a>
    <Header />
    <main class="main" id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>