---
import { aboutData } from '../lib/content';
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/'
    ? path === '/'
    : href === '/gallery'
      ? path === '/gallery' ||
        (path.startsWith('/gallery/') && !path.startsWith('/gallery/v-nalichii'))
      : path.startsWith(href);

const fullName = `${aboutData.name} ${aboutData.surname}`.trim();

const nav = [
  { href: '/gallery', label: 'Галерея' },
  { href: '/gallery/v-nalichii', label: 'В наличии' },
  { href: '/news', label: 'Новости' },
  { href: '/about', label: 'Об авторе' },
  { href: '/exhibitions', label: 'Выставки' },
  { href: '/contacts', label: 'Контакты' },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand">
      <span class="brand-name">{fullName}</span>
      <span class="brand-role">живопись, графика</span>
    </a>
    <!-- Бургер только на мобильном (CSS); подпись «Меню» рядом с иконкой —
         чтобы кнопку не пропускали глазами. Без JS кнопки нет, меню
         остаётся видимым строкой (fallback без прокрутки не работает). -->
    <button type="button" class="burger" aria-expanded="false" aria-controls="main-nav">
      <svg class="burger-icon" width="18" height="14" viewBox="0 0 18 14" aria-hidden="true">
        <path d="M1 1h16M1 7h16M1 13h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
      </svg>
      Меню
    </button>
    <nav class="nav" id="main-nav" aria-label="Основная навигация">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={['nav-link', { active: isActive(item.href) }]}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  // Бургер-меню мобильного размера: открытие/закрытие кнопкой, закрытие по
  // клику на пункт, вне меню, Esc. На десктопе кнопки нет — всё no-op.
  const header = document.querySelector('.site-header');
  const burger = header?.querySelector('.burger');
  const nav = header?.querySelector('#main-nav');
  if (header && burger && nav) {
    header.classList.add('has-burger'); // только с JS прячем строку меню

    const close = () => {
      nav.classList.remove('open');
      burger.setAttribute('aria-expanded', 'false');
    };
    burger.addEventListener('click', () => {
      const open = nav.classList.toggle('open');
      burger.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    nav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) close();
    });
    document.addEventListener('click', (e) => {
      if (!header.contains(e.target as Node)) close();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    /* Сплошной фон без backdrop-filter: размытие в липкой шапке —
       известный триггер пропаданий/белых экранов в мобильном WebKit. */
    background: #fff;
    border-bottom: 1px solid var(--line);
  }
  .header-inner {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    padding-block: 18px;
  }
  .brand { display: flex; flex-direction: column; gap: 0; }
  .brand-name {
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    line-height: 1.05;
  }
  .brand-role {
    font-size: 0.78rem;
    color: var(--fg-soft);
    letter-spacing: 0.08em;
    text-transform: lowercase;
  }
  .nav { display: flex; gap: 26px; }
  /* Бургер скрыт всегда, кроме мобильного размера. */
  .burger { display: none; }
  .nav-link {
    font-size: 1.18rem;
    color: var(--fg-soft);
    position: relative;
    padding-block: 4px;
    letter-spacing: 0.01em;
  }
  .nav-link.active { color: var(--fg); }
  .nav-link.active::after {
    content: '';
    position: absolute;
    left: 0; right: 0; bottom: -2px;
    height: 1px;
    background: var(--fg);
  }
  @media (max-width: 720px) {
    /* Бургер вместо строки меню. Без JS класс has-burger не ставится —
       меню остаётся видимой строкой (fallback). */
    .has-burger .burger {
      display: flex;
      align-items: center;
      gap: 8px;
      font: inherit; /* шапка на Cormorant, как и пункты меню */
      font-size: 1.1rem;
      color: var(--fg);
      background: none;
      border: 0;
      padding: 6px 8px;
      margin: -6px -8px; /* поля кнопки не сдвигают строку шапки */
      cursor: pointer;
    }
    .burger-icon { display: block; }
    .has-burger .nav {
      display: none;
      gap: 0;
      overflow: visible;
    }
    /* Раскрытое: панель во всю ширину под шапкой, поверх контента. */
    .has-burger .nav.open {
      display: flex;
      flex-direction: column;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: #fff;
      border-bottom: 1px solid var(--line);
      padding: 8px 24px 16px;
    }
    .has-burger .nav .nav-link {
      padding: 12px 0;
      border-bottom: 1px solid var(--line);
    }
    .has-burger .nav .nav-link:last-child { border-bottom: 0; }
  }
</style>