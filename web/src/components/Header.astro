---
import { aboutData } from '../lib/content';
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/'
    ? path === '/'
    : href === '/gallery'
      ? path === '/gallery' ||
        (path.startsWith('/gallery/') && !path.startsWith('/gallery/v-nalichii'))
      : path.startsWith(href);

const fullName = `${aboutData.name} ${aboutData.surname}`.trim();

const nav = [
  { href: '/gallery', label: 'Галерея' },
  { href: '/gallery/v-nalichii', label: 'В наличии' },
  { href: '/news', label: 'Новости' },
  { href: '/about', label: 'Об авторе' },
  { href: '/exhibitions', label: 'Выставки' },
  { href: '/contacts', label: 'Контакты' },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand">
      <span class="brand-name">{fullName}</span>
      <span class="brand-role">живопись, графика</span>
    </a>
    <nav class="nav" aria-label="Основная навигация">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={['nav-link', { active: isActive(item.href) }]}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    /* Сплошной фон без backdrop-filter: размытие в липкой шапке —
       известный триггер пропаданий/белых экранов в мобильном WebKit. */
    background: #fff;
    border-bottom: 1px solid var(--line);
  }
  .header-inner {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    padding-block: 18px;
  }
  .brand { display: flex; flex-direction: column; gap: 0; }
  .brand-name {
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    line-height: 1.05;
  }
  .brand-role {
    font-size: 0.78rem;
    color: var(--fg-soft);
    letter-spacing: 0.08em;
    text-transform: lowercase;
  }
  .nav { display: flex; gap: 26px; }
  .nav-link {
    font-size: 1.18rem;
    color: var(--fg-soft);
    position: relative;
    padding-block: 4px;
    letter-spacing: 0.01em;
  }
  .nav-link.active { color: var(--fg); }
  .nav-link.active::after {
    content: '';
    position: absolute;
    left: 0; right: 0; bottom: -2px;
    height: 1px;
    background: var(--fg);
  }
  @media (max-width: 720px) {
    .nav { gap: 16px; overflow-x: auto; }
    .header-inner { flex-wrap: wrap; }
  }
</style>